---
import GridLines from './GridLines.astro';
---

<section id="about" class="relative overflow-hidden bg-bone">
	<GridLines />

	<div
		class="relative z-10 px-[clamp(20px,calc(var(--w)*4/100),80px)] pb-[clamp(72px,calc(var(--w)*7/100),132px)] pt-[clamp(72px,calc(var(--w)*7/100),132px)]"
	>
		<p
			class="display text-center text-[clamp(16px,calc(var(--w)*1.6/100),30px)] leading-none tracking-[0.09em] text-green-deep"
			data-anim="up"
		>
			About Saya
		</p>

		{/* Short enough to hold two lines on desktop, so it needs a single break
		    rather than a stack of them — and it wraps cleanly once that break
		    drops away below lg. */}
		<h2
			class="display mx-auto mt-[clamp(28px,calc(var(--w)*3.4/100),64px)] max-w-full text-center text-[clamp(30px,calc(var(--w)*3.67/100),69px)] leading-[1.12] text-ink lg:max-w-[calc(var(--w)*1120/1880)] lg:leading-[0.94]"
			data-split="soft"
		>
			{/* A circle, not the old wide lozenge: the cup shot is portrait, and a
			    landscape pill would have squashed it. Kept close to the original
			    1.13em so it still sits inside the headline's tight leading. */}
			At Saya, a good cup is never rushed <br class="max-lg:hidden" />it&rsquo;s an invitation<span
				class="mx-[0.14em] inline-flex h-[1.3em] w-[1.3em] -translate-y-[0.08em] items-center justify-center overflow-hidden rounded-full bg-white align-middle"
				><img src="/images/brew2.png" alt="" class="h-[1.05em] w-auto object-contain" /></span
			>to slow down
		</h2>
	</div>
</section>
